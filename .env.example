NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://guardian_app:change-this-password@127.0.0.1:5432/guardian_exams
DATABASE_SSL=false
PG_POOL_MAX=10
SESSION_MAX_DAYS=7
OTP_DELIVERY=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Guardian Exams
# MobileSasa sends SMS OTPs, password reset codes and marketplace payment receipts.
MOBILESASA_API_KEY=
MOBILESASA_SENDER_ID=MOBILESASA
MOBILESASA_BASE_URL=https://api.mobilesasa.com
# Safaricom Daraja credentials; use sandbox until callback and payment flows are accepted.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://exams.example.co.ke/api/mpesa/callback
MPESA_CALLBACK_SECRET=
# Illustrative prototype split only; approve the vendor/platform commission before launch.
MARKETPLACE_VENDOR_SHARE_PERCENT=80
# Use a generated, stable secret (32+ random bytes) outside development.
AUTH_OTP_PEPPER=
# Set these once to bootstrap the first Platform admin; use a unique 12+ character password.
BOOTSTRAP_ADMIN_NAME=Guardian Exams Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
